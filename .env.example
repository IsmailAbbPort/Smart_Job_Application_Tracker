# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

ENVIRONMENT=development

# Postgres + pgvector. Matches the docker-compose service by default.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jobtracker

# AI provider keys (unused until Phase 3+). Leave blank for Phase 0.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
