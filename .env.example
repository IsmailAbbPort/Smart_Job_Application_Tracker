# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

ENVIRONMENT=development

# Postgres + pgvector. Matches the docker-compose service by default.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jobtracker

# OpenAI: used from Phase 2 for embeddings (text-embedding-3-small). Required for
# /cv and /match/embed-jobs. Anthropic: used from Phase 3 for the match judge.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AI models are swappable without code changes. Defaults shown; override to A/B.
# EMBEDDING_DIMENSIONS must equal the pgvector column (1536). text-embedding-3
# models can be truncated to it, so small<->large needs no migration; a model with
# a different native dim (e.g. a non-OpenAI provider) would need one.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
JUDGE_MODEL=claude-haiku-4-5-20251001
